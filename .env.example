# Copy to .env and fill in your values. Never commit .env.

# --- Strands Decider 2B (where the decisions run) --------------------------------
# Option A: AWS User Group Madurai hosted API (free during the hackathon)
DECIDER_MODE=ugmdu
DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
DECIDER_API_KEY=                        # from https://www.awsugmdu.in

# Option B: local strands-decider server (no cloud cost; run: strands-decider serve)
# DECIDER_MODE=local
# DECIDER_URL=http://127.0.0.1:8099

# --- LLM (always through Strands Agents SDK) --------------------------------------
LLM_PROVIDER=bedrock                    # bedrock | local (Ollama) | ugmdu
# bedrock: needs AWS credentials (AWS_ACCESS_KEY_ID + SECRET, or a profile)
# local:   needs Ollama running: OLLAMA_URL=http://127.0.0.1:11434  LLM_MODEL_ID=qwen3.5:4b
# ugmdu:   uses DECIDER_API_KEY above

# --- Amazon Bedrock (bedrock provider) -------------------------------------------
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
AWS_REGION=us-east-1
# AWS_PROFILE=default                   # optional: select a named CLI profile

# --- Frontend (optional) ----------------------------------------------------------
# VITE_API_BASE=http://localhost:8000   # set in frontend/.env when running separately
